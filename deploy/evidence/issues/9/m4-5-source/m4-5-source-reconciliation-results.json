    "OBSERVED": "fresh raw authority read after uncertain outcome"
  },
  "classification": [
    {"condition": "observed == candidate (exact raw identity)", "result": "VERIFIED_RECOVERED", "retry": "no"},
    {"condition": "observed == original and fresh auth re-established", "result": "RETRYABLE_NO_EFFECT", "retry": "only with fresh bounded attempt"},
    {"condition": "observed == original but fresh auth not re-established", "result": "RECONCILING remains", "retry": "no until fresh auth"},
    {"condition": "observed != candidate and != original (third state)", "result": "CONFLICT", "retry": "no"},
    {"condition": "normalized equal but raw differs", "result": "CONFLICT (J8)", "retry": "no"}
  ],
  "precedence": ["exact candidate raw identity", "exact original raw identity", "third raw state"],
  "forbidden": ["best effort merge", "heuristic selection", "silent overwrite", "semantic rollback", "automatic newest selection"],
  "crash_windows_j1_j10": {
    "J1": "PREPARED durability fails before APPLYING -> FAILED_NO_EFFECT",
    "J2": "APPLYING known failure/no effect -> FAILED_NO_EFFECT",
    "J3": "stranded APPLYING after restart -> RECONCILING",
    "J4": "APPLYING timeout -> OUTCOME_UNKNOWN -> RECONCILING",
    "J5": "RECONCILING observed original -> RETRYABLE_NO_EFFECT (fresh auth)",
    "J6": "RECONCILING observed candidate -> VERIFIED_RECOVERED",
    "J7": "RECONCILING observed third -> CONFLICT",
    "J8": "normalized equality alone -> CONFLICT (supporting evidence only)",
    "J9": "PREPARED durability fails (variant) -> FAILED_NO_EFFECT",
    "J10": "NONTERMINAL_AFTER_TERMINAL_PERSISTENCE_FAILURE -> RECONCILING (explicit)"
  },
