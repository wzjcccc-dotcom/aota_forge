    "aota_forge/core/contracts/results.py:failure_from_error",
    "aota_forge/core/contracts/mutation.py:MutationEffect and AuthoritativeEffectConfirmation",
    "aota_forge/core/contracts/errors.py:error_from_dict and canonical error codes"
  ],
  "effect_projection": [
    {"effect": "APPLIED_VERIFIED", "ok": true, "confirmation": "yes", "rule": "requires the bounded lifecycle transaction result"},
    {"effect": "REPLAYED_VERIFIED", "ok": true, "confirmation": "yes", "rule": "replay only; no duplicate effect"},
    {"effect": "NO_EFFECT", "ok": true, "confirmation": "no", "rule": "preserve lifecycle_code and no-effect classification"},
    {"effect": "NEEDS_SEMANTIC_CHOICE", "ok": true, "confirmation": "no", "rule": "preserve semantic_choices and next_action; never collapse into authority failure"},
    {"effect": "BLOCKED", "ok": false, "confirmation": "no", "rule": "preserve blockers and canonical authorization code"},
    {"effect": "CONFLICT", "ok": false, "confirmation": "no", "rule": "preserve conflict identity and no-effect semantics"},
    {"effect": "OUTCOME_UNKNOWN", "ok": false, "confirmation": "unknown", "rule": "reconciliation required; never report success or blindly retry"},
    {"effect": "FAILED_NO_EFFECT", "ok": false, "confirmation": "no", "rule": "preserve failed-no-effect classification"}
  ],
  "error_lanes": {
    "ingress_contract": ["UNSUPPORTED_OPERATION", "UNKNOWN_INPUT", "REQUIRED_INPUT_MISSING", "INPUT_TYPE_INVALID", "INPUT_SIZE_EXCEEDED"],
    "authorization": ["AUTHORIZATION_MISSING", "AUTHORIZATION_OPERATION_MISMATCH", "AUTHORIZATION_TARGET_MISMATCH", "AUTHORIZATION_SCOPE_MISMATCH", "AUTHORIZATION_CONTRACT_DRIFT", "APPROVAL_REQUIRED", "MATERIALIZED_DECISION_REQUIRED", "LEASE_EXPIRED", "LEASE_REVOKED", "LEASE_CONSUMED", "LEASE_INTENT_MISMATCH", "LEASE_TARGET_MISMATCH", "LEASE_SCOPE_MISMATCH", "SUBJECT_REVISION_STALE", "AUTHORITY_PRECONDITION_STALE", "OUTCOME_UNKNOWN_REQUIRES_RECONCILIATION", "NEEDS_SEMANTIC_CHOICE"],
    "lifecycle": ["PROJECT_NOT_FOUND", "PROJECT_BINDING_REQUIRED", "PLAN_INIT_INVALID_PREDECESSOR", "PLAN_INIT_ALREADY_INITIALIZED", "PLAN_INIT_STALE_SUBJECT_REVISION", "PLAN_INIT_STALE_AUTHORITY_PRECONDITION", "RETIREMENT_NO_CANDIDATE", "RETIREMENT_NEEDS_SEMANTIC_CHOICE", "RETIREMENT_STALE_SNAPSHOT", "RETIREMENT_TARGET_PROTECTED", "RETIREMENT_RUNNING_TASK_PROTECTED", "RETIREMENT_SUCCESSOR_REQUIRED", "RETIREMENT_SUCCESSOR_INVALID", "RETIREMENT_SELF_SUCCESSOR", "RETIREMENT_STALE_AUTHORITY_PRECONDITION", "CONFLICT"]
  },
  "projection_rules": [
    "Do not convert NEEDS_SEMANTIC_CHOICE into generic AUTHORIZATION_MISSING.",
    "Do not convert a local handler return into APPLIED_VERIFIED without the lifecycle result confirmation.",
    "Do not derive error codes from exception class names when an existing canonical code is available.",
    "Keep lifecycle_code, mutation_effect, authoritative_effect_confirmed, effect_evidence, blockers, semantic_choices, next_action, and correlation_id visible.",
    "Do not expose credentials, trusted context tokens, raw filesystem paths, or private storage internals."
  ],
  "read_path_rule": "Existing read-only execute result normalization remains the compatibility path for read operations; write projection is additive and does not alter read semantics."
